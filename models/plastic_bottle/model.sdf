<?xml version="1.0" ?>
<sdf version='1.6'>
  <model name='plastic_bottle'>
    <static>false</static>
    <link name="bottle_link">
      <inertial>
        <mass>0.35</mass>
        <inertia>
          <ixx>0.0008</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0008</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <!-- Bottle body (main cylinder) -->
      <collision name="bottle_body_collision">
        <pose>0 0 0.075 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <visual name="bottle_body_visual">
        <pose>0 0 0.075 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <uri>model://plastic_bottle/materials/scripts</uri>
            <name>bottle_material</name>
          </script>
          <ambient>0.9 0.9 0.9 0.8</ambient>
          <diffuse>0.9 0.9 0.9 0.8</diffuse>
          <specular>1.0 1.0 1.0 0.8</specular>
        </material>
      </visual>

      <!-- Water inside bottle -->
      <visual name="water_visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.029</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <uri>model://plastic_bottle/materials/scripts</uri>
            <name>water_material</name>
          </script>
          <ambient>0.7 0.9 1.0 0.3</ambient>
          <diffuse>0.7 0.9 1.0 0.3</diffuse>
          <specular>1.0 1.0 1.0 0.3</specular>
        </material>
      </visual>

      <!-- Yellow label -->
      <visual name="label_visual">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0312</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <uri>model://plastic_bottle/materials/scripts</uri>
            <name>label_material</name>
          </script>
          <ambient>1.0 1.0 0.0 1.0</ambient>
          <diffuse>1.0 1.0 0.0 1.0</diffuse>
          <specular>0.2 0.2 0.0 1.0</specular>
        </material>
      </visual>

      <!-- Bottle cap -->
      <collision name="bottle_cap_collision">
        <pose>0 0 0.155 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      
      <visual name="bottle_cap_visual">
        <pose>0 0 0.155 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>