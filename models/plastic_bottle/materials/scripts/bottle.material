material bottle_material
{
  technique
  {
    pass
    {
      ambient 0.9 0.9 0.9 0.8
      diffuse 0.9 0.9 0.9 0.8
      specular 1.0 1.0 1.0 0.8 32
      
      alpha_rejection greater_equal 128
      scene_blend alpha_blend
      depth_write off
      
      texture_unit
      {
        colour_op_ex source1 src_manual src_current 0.9 0.9 0.9
        alpha_op_ex source1 src_manual src_current 0.8
      }
    }
  }
}

material water_material
{
  technique
  {
    pass
    {
      ambient 0.7 0.9 1.0 0.3
      diffuse 0.7 0.9 1.0 0.3
      specular 1.0 1.0 1.0 0.3 32
      
      alpha_rejection greater_equal 32
      scene_blend alpha_blend
      depth_write off
      
      texture_unit
      {
        colour_op_ex source1 src_manual src_current 0.7 0.9 1.0
        alpha_op_ex source1 src_manual src_current 0.3
      }
    }
  }
}

material label_material
{
  technique
  {
    pass
    {
      ambient 1.0 1.0 0.0 1.0
      diffuse 1.0 1.0 0.0 1.0
      specular 0.2 0.2 0.0 1.0 16
      
      texture_unit
      {
        colour_op_ex source1 src_manual src_current 1.0 1.0 0.0
        alpha_op_ex source1 src_manual src_current 1.0
      }
    }
  }
}